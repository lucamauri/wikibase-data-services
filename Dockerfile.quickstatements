# =============================================================================
# Dockerfile.quickstatements
#
# Extends the upstream wikibase/quickstatements:1 image to make batch
# processing work in a self-hosted (non-Wikimedia) environment.
#
# WHY THIS DOCKERFILE EXISTS
# --------------------------
# The upstream image is designed for Wikimedia Toolforge infrastructure.
# Four things are missing or incompatible with a standalone deployment:
#
#   1. The `mysqli` PHP extension is not compiled into the upstream image.
#      QuickStatements uses the `magnustools` library (ToolforgeCommon) for
#      all database access, which requires `mysqli` with no fallback.
#      Without it, batch mode crashes immediately with:
#        Fatal error: Uncaught Error: Class "mysqli" not found
#      Interactive ("Run") mode is unaffected because it uses the Wikibase
#      API directly and never touches the database.
#
#   2. There is no batch runner process. On Wikimedia Toolforge, batches are
#      executed by the `jsub` job scheduler, which does not exist here.
#      Without it, batches are created in the database but stay in INIT
#      status forever — the progress bar never moves.
#      Fix: run bot.php every minute via cron inside the container.
#
#   3. The magnustools curl_multi code sends no User-Agent header, which
#      causes Anubis (the bot protection layer) to block API requests with
#      an HTML challenge page instead of JSON. This makes loadItems() fail
#      silently and bot.php report "Item Qxxx is not available".
#      Fix: patch wikidata.php at build time to add CURLOPT_USERAGENT.
#
#   4. The database credentials file (replica.my.cnf) does not exist in the
#      container by default, and the upstream entrypoint does not create it.
#      Fix: a wrapper entrypoint substitutes credentials from environment
#      variables at startup and writes the file to the expected path.
#
# Full details and host-side setup steps:
#   docs/decisions/006-quickstatements-batch-fix.md
#
# BASE IMAGE
# ----------
# wikibase/quickstatements:1 — PHP 8.3 on Debian 12 (bookworm)
# Rebuild this image when the upstream is updated:
#   docker compose build quickstatements
# =============================================================================

FROM wikibase/quickstatements:1

# -----------------------------------------------------------------------------
# Fix 1 — Add the mysqli PHP extension
# -----------------------------------------------------------------------------
# docker-php-ext-install is a helper script included in all official PHP
# Docker images. It compiles and enables the named extension against the
# PHP version already in the image — no manual phpize needed.
#
# mysqli is required by ToolforgeCommon->getDB() for all database operations,
# including batch creation, status tracking, and the batch runner (bot.php).
# -----------------------------------------------------------------------------
RUN docker-php-ext-install mysqli

# -----------------------------------------------------------------------------
# Fix 2 — Add a cron-based batch runner
# -----------------------------------------------------------------------------
# bot.php is QuickStatements' batch execution script. It picks up one batch
# in INIT or RUN status and processes it, then exits.
#
# On Wikimedia Toolforge this is triggered by the jsub job scheduler.
# In a self-hosted container there is no jsub, so we install cron and run
# bot.php every minute instead.
#
# The job runs as www-data (the same user Apache workers run as) so it has
# the same filesystem and credential access as the web process.
#
# Logs go to /var/log/quickstatements/bot.log — check this file first
# when debugging batch execution problems.
#
# apt-get clean and rm -rf /var/lib/apt/lists/* keep the image layer small
# by discarding the package index after installation.
# -----------------------------------------------------------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends cron \
    && rm -rf /var/lib/apt/lists/*

RUN echo "* * * * * www-data /usr/local/bin/php \
/var/www/html/quickstatements/bot.php single_batch \
>> /var/log/quickstatements/bot.log 2>&1" \
    > /etc/cron.d/quickstatements-bot \
    && chmod 0644 /etc/cron.d/quickstatements-bot

# -----------------------------------------------------------------------------
# Fix 3 — Patch magnustools to send a User-Agent in curl_multi requests
# -----------------------------------------------------------------------------
# getMultipleURLsInParallel() in wikidata.php uses curl_multi to fetch Wikibase
# items. It sets CURLOPT_RETURNTRANSFER and SSL options but never sets a
# User-Agent header. PHP's curl extension ignores the php.ini user_agent
# setting — it sends no User-Agent by default.
#
# Anubis (the bot protection layer in front of Apache/MediaWiki) blocks
# requests with no User-Agent, returning an HTML challenge page instead of
# JSON. This causes loadItems() to silently fail and bot.php to report
# "Item Qxxx is not available" on every batch command.
#
# The sed command inserts CURLOPT_USERAGENT immediately after the existing
# CURLOPT_SSL_VERIFYHOST line — the only place where curl handle options
# are set for each URL in the batch.
#
# The User-Agent string "QuickStatements/1.0 (self-hosted bot)" is intentionally
# generic — it accurately identifies any deployment of this stack without
# requiring site-specific customisation.
# -----------------------------------------------------------------------------
RUN sed -i \
  's|curl_setopt(\$ch\[$key\], CURLOPT_SSL_VERIFYHOST, false);|curl_setopt($ch[$key], CURLOPT_SSL_VERIFYHOST, false);\n                                curl_setopt($ch[$key], CURLOPT_USERAGENT, '"'"'QuickStatements/1.0 (self-hosted bot)'"'"');|' \
  /var/www/html/magnustools/public_html/php/wikidata.php

# -----------------------------------------------------------------------------
# Fix 4 — Wrapper entrypoint for credential injection
# -----------------------------------------------------------------------------
# The upstream entrypoint starts Apache directly. Our wrapper runs first and:
#   1. Creates /data/project/nobody/ (the Toolforge-convention path where
#      ToolforgeCommon looks for replica.my.cnf)
#   2. Runs envsubst on the replica.my.cnf template (mounted via compose),
#      substituting ${QS_DB_USER} and ${QS_DB_PASSWORD} from the environment
#   3. Sets ownership root:www-data and permissions 640 so Apache workers
#      can read the file but it is not world-readable
#   4. Starts cron in the background
#   5. Hands off to the upstream /entrypoint.sh (which handles oauth.ini,
#      config.json substitution, then starts Apache)
#
# Credentials are never baked into the image — they are injected at runtime.
# -----------------------------------------------------------------------------
COPY config/quickstatements-entrypoint.sh /quickstatements-entrypoint.sh
RUN chmod +x /quickstatements-entrypoint.sh

# -----------------------------------------------------------------------------
# Fix 6 — Replace the hardcoded Toolforge logo with an operator-configurable one
# -----------------------------------------------------------------------------
# (Fix 5 — the lowercase site-identifier fix — has no Dockerfile component;
# it is implemented entirely in quickstatements-entrypoint.sh and
# config/quickstatements-config.json. See docs/decisions/006-quickstatements-batch-fix.md
# for the full numbered list of problems and fixes.)
#
# BACKGROUND — why this isn't a simple sed patch on an existing file
# -------------------------------------------------------------------
# The Toolforge-branded navbar (tool-navbar.html) is NOT shipped as a local
# file that Apache serves. QuickStatements' vue.js calls:
#
#   vue_components.loadComponents(['wd-date', 'wd-link', 'tool-translate',
#                                   'tool-navbar', 'commons-thumbnail', ...])
#
# and shared.js (itself fetched live from Wikimedia's CDN at
# https://tools-static.wmflabs.org/magnustools/resources/vue/shared.js)
# resolves any bare component name — like 'tool-navbar' — by prepending
# components_base_url, i.e. fetching it directly from Wikimedia's CDN:
#
#   https://tools-static.wmflabs.org/magnustools/resources/vue/tool-navbar.html
#
# This happens entirely in the browser, at runtime, bypassing our container
# completely. There is no local copy of tool-navbar.html in the served
# DocumentRoot (/var/www/html/quickstatements/public_html) to patch.
#
# THE FIX — two parts
# --------------------
# 1. Ship our own copy of the component (config/quickstatements-tool-navbar.html)
#    with the logo already replaced by a ${QS_LOGO_URL} placeholder, and COPY
#    it into the served directory at resources/vue/tool-navbar.html.
#
# 2. Patch vue.js so the loadComponents(...) array entry changes from the bare
#    name 'tool-navbar' to the local, .html-suffixed path
#    'resources/vue/tool-navbar.html'. Per shared.js's own resolution logic:
#
#      /^(http:|https:|\/|\.)/.test(component) || /\.html$/.test(component)
#        ? component
#        : this.components_base_url + component + '.html'
#
#    any entry already ending in .html is used as a literal path, bypassing
#    components_base_url (the CDN) entirely. This affects ONLY the
#    'tool-navbar' entry — all other bare-named entries in the same array
#    (wd-date, wd-link, tool-translate, commons-thumbnail) are untouched and
#    continue loading from Wikimedia's CDN exactly as before.
#
# ${QS_LOGO_URL} itself is resolved at container startup by
# quickstatements-entrypoint.sh via envsubst, using the operator's
# QUICKSTATEMENTS_LOGO value (falling back to WIKIBASE_LOGO if unset).
# -----------------------------------------------------------------------------

# Part 1 — copy our patched local component into the served directory.
# The file still contains the literal ${QS_LOGO_URL} placeholder at this
# point; envsubst resolves it at container startup, not at build time,
# since the actual logo URL is an operator-configured runtime value.
COPY config/quickstatements-tool-navbar.html \
     /var/www/html/quickstatements/public_html/resources/vue/tool-navbar.html

# Part 2 — redirect the 'tool-navbar' component lookup to our local file.
# sed delimiter: "|" is used instead of the default "/" because the
# replacement path contains forward slashes.
RUN sed -i \
  "s|'tool-navbar'|'resources/vue/tool-navbar.html'|" \
  /var/www/html/quickstatements/public_html/vue.js

ENTRYPOINT ["/quickstatements-entrypoint.sh"]